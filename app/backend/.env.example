# ─── Local development ───────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.

# Server
NODE_ENV=development
PORT=5000

# Database — local Docker
DB_HOST=localhost
DB_PORT=5432
DB_NAME=arrow_db
DB_USER=postgres
DB_PASSWORD=postgres

# Database — production (Render / Neon / Supabase)
# Use a single DATABASE_URL instead of the individual vars above.
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# API
API_BASE_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Production CORS (your Vercel URL)
# CORS_ORIGIN=https://your-app.vercel.app

# Logging
LOG_LEVEL=info

# Auth — generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=1d
