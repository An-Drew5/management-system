# Server Configuration
NODE_ENV=production
PORT=5000

# Database Configuration
DB_HOST=db-host.example.com
DB_PORT=5432
DB_NAME=arrow_db_prod
DB_USER=postgres
DB_PASSWORD=your_secure_password

# API Configuration
API_BASE_URL=https://api.arrow.com
CORS_ORIGIN=https://arrow.com

# Logging
LOG_LEVEL=error

# Auth Configuration
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=1d
